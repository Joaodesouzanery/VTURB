  background: transparent; color: var(--bxfit-texto, #303030);
  border: 1px solid var(--bxfit-borda, #E8E4DE);
  border-radius: var(--bxfit-raio, 8px);
  font: inherit; font-size: 0.92em; line-height: 1.2;
  transition: border-color .15s ease, background-color .15s ease;
}
.bxfit-abrir:hover { border-color: var(--bxfit-acento, #1B472B); }
.bxfit-abrir:focus-visible { outline: 2px solid var(--bxfit-acento, #1B472B); outline-offset: 2px; }

.bxfit-modal[hidden] { display: none; }
.bxfit-modal {
  position: fixed; inset: 0; z-index: 2147483000;
  display: flex; align-items: center; justify-content: center; padding: 16px;
}
.bxfit-fundo { position: absolute; inset: 0; background: rgba(16,16,16,.55); }
.bxfit-caixa {
