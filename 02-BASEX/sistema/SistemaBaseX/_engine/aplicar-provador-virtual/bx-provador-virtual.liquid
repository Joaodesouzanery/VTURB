{% comment %}
  ============================================================
  BX Provador Virtual — recomendacao de tamanho
  ------------------------------------------------------------
  Section autocontida. Nao toca em layout/theme.liquid, nao toca
  em assets/base.css e nao depende de JS interno do tema.

  Onde colocar: no template de produto, logo abaixo do bloco de
  informacoes. O botao se ancora sozinho perto do seletor de
  tamanho quando encontra um.

  Fonte de dados da tabela de medidas, nesta ordem:
    1. metafield do produto  custom.tabela_medidas  (JSON)
    2. o campo "Tabela de medidas" desta section
    3. nada -> a section nao renderiza (melhor sumir do que
       recomendar sem lastro)

  Gerado por _engine/aplicar-provador-virtual/montar.mjs
  NAO editar direto: editar os modulos e rodar o montador.
  ============================================================
{% endcomment %}

{%- liquid
  assign op_tamanho = nil
  assign nomes_tamanho = 'tamanho,size,talla,taille,grosse,größe,misura,maat,storlek'
  for op in product.options_with_values
    assign nome_min = op.name | downcase
    if nomes_tamanho contains nome_min
      assign op_tamanho = op
      break
    endif
  endfor

  comment
    Nada de tabela = nada de provador. Recomendar tamanho sem medida
    da peca seria adivinhacao com cara de calculo.
  endcomment
  assign json_metafield = product.metafields.custom.tabela_medidas.value
  assign json_section = section.settings.tabela_json
  assign tem_dados = false
  if json_metafield != blank
    assign tem_dados = true
  elsif json_section != blank
    assign tem_dados = true
  endif
-%}

{%- if tem_dados and op_tamanho != nil -%}

<div
  class="bx-provador color-{{ section.settings.color_scheme }}"
  id="bx-provador-{{ section.id }}"
  data-bx-provador
  style="
    --bxfit-acento: {{ section.settings.cor_acento }};
    --bxfit-texto: {{ section.settings.cor_texto }};
    --bxfit-fundo: {{ section.settings.cor_fundo }};
    --bxfit-borda: {{ section.settings.cor_borda }};
    --bxfit-raio: {{ section.settings.raio }}px;
    --bxfit-margem: {{ section.settings.margem_topo }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="bxfit-slot"></div>

  <script type="application/json" data-bx-config>
    {
      "produto": {{ product.title | json }},
      "handle": {{ product.handle | json }},
      "textoBotao": {{ section.settings.texto_botao | json }},
      "textoTitulo": {{ section.settings.texto_titulo | json }},
      "perfilId": {{ section.settings.perfil | json }},
      "caimento": {{ section.settings.caimento | json }},
      "tecido": {{ section.settings.tecido | json }},
      "sexo": {{ section.settings.sexo | json }},
      "unidade": {{ section.settings.unidade | json }},
      "escalaDetalhada": {{ section.settings.escala_detalhada | json }},
      "vesteEm": {{ section.settings.veste_em | json }},
      "ancorar": {{ section.settings.ancorar | json }},
      "opcaoTamanho": {
        "nome": {{ op_tamanho.name | json }},
        "posicao": {{ op_tamanho.position | json }},
        "valores": {{ op_tamanho.values | json }}
      },
      "disponiveis": [
        {%- assign sep = '' -%}
        {%- for v in op_tamanho.values -%}
          {%- assign achou = false -%}
          {%- for var in product.variants -%}
            {%- if var.available -%}
              {%- if op_tamanho.position == 1 and var.option1 == v -%}{%- assign achou = true -%}{%- endif -%}
              {%- if op_tamanho.position == 2 and var.option2 == v -%}{%- assign achou = true -%}{%- endif -%}
              {%- if op_tamanho.position == 3 and var.option3 == v -%}{%- assign achou = true -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if achou -%}{{ sep }}{{ v | json }}{%- assign sep = ',' -%}{%- endif -%}
        {%- endfor -%}
      ],
      "tabela": {% if json_metafield != blank %}{{ json_metafield | json }}{% else %}{{ json_section | json }}{% endif %}
    }
  </script>
</div>

{%- endif -%}

{% stylesheet %}
/* BX Provador Virtual — estilos da section.
   Tudo prefixado com bxfit para nao colidir com o tema.
   Nenhuma regra global, nenhum reset, nenhum !important em tag. */

.bx-provador { margin-top: var(--bxfit-margem, 12px); }

.bxfit-abrir {
  display: inline-flex; align-items: center; gap: 8px;
