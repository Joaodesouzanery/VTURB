@media (max-width: 560px) { .bxfit-res-corpo { grid-template-columns: 1fr; } .bxfit-res-svg { max-width: 160px; margin: 0 auto; } }
.bxfit-svg { width: 100%; height: auto; display: block; }
.bxfit-res-lista h3 { margin: 0 0 10px; font-size: 1em; }

.bxfit-legenda { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
.bxfit-linha { display: flex; align-items: center; gap: 8px; font-size: .9em; }
.bxfit-bolinha { width: 12px; height: 12px; border-radius: 3px; flex: 0 0 auto; }
.bxfit-reg-nome { font-weight: 600; min-width: 74px; }
