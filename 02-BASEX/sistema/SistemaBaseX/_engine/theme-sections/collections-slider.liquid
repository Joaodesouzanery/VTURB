{% comment %}
  Collections Slider — section customizada.
  Puxa as coleções da loja e renderiza como slider horizontal (o for do Liquid entrega até 50 coleções por padrão).
  - Desktop: 1 linha, cards deslizantes horizontalmente (scroll suave)
  - Mobile: 2 colunas menores, mais que 1 card visível
  Não edita theme.liquid nem base.css. Estilos escopados via class prefix.
{% endcomment %}

{%- assign col_list = collections -%}
{%- if section.settings.sort_by == 'alphabetical_reversed' -%}
  {%- assign col_list = collections | sort: 'title' | reverse -%}
{%- elsif section.settings.sort_by == 'products_high' -%}
  {%- assign col_list = collections | sort: 'products_count' | reverse -%}
{%- endif -%}

<section
  class="collections-slider section"
  style="
    --collections-slider-bg: {{ section.settings.background_color }};
    --collections-slider-text: {{ section.settings.text_color }};
    --collections-slider-radius: {{ section.settings.corner_radius }}px;
    --collections-slider-desktop-visible: {{ section.settings.desktop_visible }};
    --collections-slider-mobile-visible: {{ section.settings.mobile_visible }};
    --collections-slider-overlay: {{ section.settings.overlay_color }};
    --collections-slider-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --collections-slider-title-color: {{ section.settings.title_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: var(--collections-slider-bg);
  "
>
  <div class="collections-slider__inner">
    {%- if section.settings.title != blank -%}
      <div class="collections-slider__header">
        <h2 class="collections-slider__heading" style="color: var(--collections-slider-text);">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}

    <div class="collections-slider__viewport">
      <button
        class="collections-slider__arrow collections-slider__arrow--prev"
        aria-label="Previous"
        data-collections-slider-prev
        type="button"
      >‹</button>

      <div class="collections-slider__track" data-collections-slider-track>
        {%- for coll in col_list -%}
          {%- unless coll.handle == 'frontpage' or coll.handle == 'all' -%}
            <a href="{{ coll.url }}" class="collections-slider__card">
              <div class="collections-slider__media">
                {%- if coll.image != blank -%}
                  {{ coll.image | image_url: width: 800 | image_tag:
                    loading: 'lazy',
                    class: 'collections-slider__image',
                    widths: '300, 500, 800',
                    sizes: '(max-width: 749px) 45vw, 25vw'
                  }}
                {%- elsif coll.products.first.featured_media -%}
                  {{ coll.products.first.featured_media | image_url: width: 800 | image_tag:
                    loading: 'lazy',
                    class: 'collections-slider__image',
                    widths: '300, 500, 800',
                    sizes: '(max-width: 749px) 45vw, 25vw'
                  }}
                {%- else -%}
                  <div class="collections-slider__placeholder">
                    {{ 'collection-1' | placeholder_svg_tag: 'collections-slider__image' }}
                  </div>
                {%- endif -%}
                <span
                  class="collections-slider__overlay"
                  style="background-color: var(--collections-slider-overlay); opacity: var(--collections-slider-overlay-opacity);"
                ></span>
                <span class="collections-slider__title" style="color: var(--collections-slider-title-color);">
                  {{- coll.title -}}
                </span>
              </div>
            </a>
          {%- endunless -%}
        {%- endfor -%}
      </div>

      <button
        class="collections-slider__arrow collections-slider__arrow--next"
        aria-label="Next"
        data-collections-slider-next
        type="button"
      >›</button>
    </div>
  </div>
</section>

{% stylesheet %}
  .collections-slider {
    width: 100%;
  }

  .collections-slider__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .collections-slider__header {
    margin-bottom: 24px;
    text-align: center;
  }

  .collections-slider__heading {
    font-family: var(--font-heading--family, inherit);
    font-size: 28px;
    margin: 0;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .collections-slider__viewport {
    position: relative;
  }

  .collections-slider__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 4px 0;
  }

  .collections-slider__track::-webkit-scrollbar {
    display: none;
  }

  .collections-slider__card {
    flex: 0 0 auto;
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    display: block;
    width: calc((100% - (var(--collections-slider-desktop-visible) - 1) * 16px) / var(--collections-slider-desktop-visible));
  }

  .collections-slider__media {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--collections-slider-radius);
    background-color: #eee;
  }

  .collections-slider__image,
  .collections-slider__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .collections-slider__card:hover .collections-slider__image,
  .collections-slider__card:hover .collections-slider__placeholder svg {
    transform: scale(1.05);
  }

  .collections-slider__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .collections-slider__title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    text-align: center;
    font-family: var(--font-heading--family, inherit);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 16px;
    padding: 0 12px;
  }

  .collections-slider__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(59, 47, 42, 0.2);
    background: rgba(251, 246, 242, 0.95);
    color: #3B2F2A;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease;
    padding: 0;
  }

  .collections-slider__arrow:hover {
    background: #FBF6F2;
    transform: translateY(-50%) scale(1.05);
  }

  .collections-slider__arrow--prev {
    left: 8px;
  }

  .collections-slider__arrow--next {
    right: 8px;
  }

  @media (min-width: 750px) {
    .collections-slider__arrow {
      display: flex;
    }
    .collections-slider__title {
      font-size: 18px;
      bottom: 20px;
    }
  }

  @media (max-width: 749px) {
    .collections-slider__inner {
      padding: 0 16px;
    }
    .collections-slider__heading {
      font-size: 22px;
    }
    .collections-slider__card {
      width: calc((100% - (var(--collections-slider-mobile-visible) - 1) * 12px) / var(--collections-slider-mobile-visible));
    }
    .collections-slider__track {
      gap: 12px;
    }
    .collections-slider__title {
      font-size: 13px;
      bottom: 10px;
      letter-spacing: 0.03em;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.collections-slider__viewport').forEach(function (viewport) {
    const track = viewport.querySelector('[data-collections-slider-track]');
    const prev = viewport.querySelector('[data-collections-slider-prev]');
    const next = viewport.querySelector('[data-collections-slider-next]');
    if (!track || !prev || !next) return;

    function scrollBy(direction) {
      const firstCard = track.querySelector('.collections-slider__card');
      const step = firstCard ? firstCard.getBoundingClientRect().width + 16 : 300;
      track.scrollBy({ left: direction * step, behavior: 'smooth' });
    }

    prev.addEventListener('click', function () { scrollBy(-1); });
    next.addEventListener('click', function () { scrollBy(1); });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Collections Slider",
  "tag": "section",
  "class": "collections-slider-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Puxa as coleções da loja automaticamente (até 50, limite padrão do for do Liquid) e renderiza como slider horizontal. Substitui a lista tradicional de coleções (main-list-collections) para dar layout de 1 linha com scroll no desktop."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "select",
      "id": "sort_by",
      "label": "Sort collections",
      "options": [
        { "value": "alphabetical", "label": "A-Z" },
        { "value": "alphabetical_reversed", "label": "Z-A" },
        { "value": "products_high", "label": "Product count (high to low)" }
      ],
      "default": "alphabetical"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_visible",
      "label": "Cards visible desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "mobile_visible",
      "label": "Cards visible mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FBF6F2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#3B2F2A"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image overlay color",
      "default": "#3B2F2A"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 20,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Card title color (over image)",
      "default": "#FBF6F2"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Collections Slider"
    }
  ]
}
{% endschema %}
